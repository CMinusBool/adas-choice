dist/
node_modules/
.scratch/
# Agent scaffolding: worktrees/ holds live nested checkouts that a stray
# `git add -A` would commit wholesale, and settings.local.json is machine-local.
.claude/
# Source artwork: the Character Sheets are the identity source for every Actor,
# and they are megabytes each. Runtime assets are cut from them into public/.
# Anchored: unanchored, this also swallowed `scripts/art/`, the tracked toolchain
# that generates them.
/art/
*.tar.gz
# Deploy artifact from deploy-claude-config.sh; .tgz escapes *.tar.gz above.
claude-config.tgz
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
playwright-report/
test-results/
# Byte-cache the repo's Python scripts leave behind. Unanchored on purpose:
# `scripts/check_tickets_test.py` writes `scripts/__pycache__/` on every run, and
# a hook test run from anywhere else writes one beside itself.
__pycache__/
